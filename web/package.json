{
  "name": "pitwall-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:types": "cargo run -q -p pitwall-schema --features schema-gen --bin export-schema > schema.json && json2ts -i schema.json -o src/types.gen.ts && rm schema.json"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-rnd": "^10.5.3",
    "three": "^0.186.1",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
